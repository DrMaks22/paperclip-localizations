+    trigger!.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true, button: 0 }));
+    trigger!.dispatchEvent(new MouseEvent("click", { bubbles: true }));
+  });
+  await flushQueries();
+
+  return trigger!;
