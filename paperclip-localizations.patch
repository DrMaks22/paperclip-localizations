@@ -0,0 +1,168 @@
+// @vitest-environment jsdom
+
+import { renderToStaticMarkup } from "react-dom/server";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import type { AgentDetail, AgentRuntimeState, HeartbeatRun, Issue } from "@paperclipai/shared";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { i18n } from "@/i18n";
+import { AgentOverview } from "./AgentDetail";
+import { DialogProvider } from "../context/DialogContext";
+import { TooltipProvider } from "@/components/ui/tooltip";
+import { queryKeys } from "../lib/queryKeys";
+
+vi.mock("@/lib/router", async () => {
+  const actual = await vi.importActual<typeof import("react-router-dom")>("react-router-dom");
+  return {
+    ...actual,
+    Link: ({ to, children, ...props }: { to: string; children: React.ReactNode }) => (
+      <a href={to} {...props}>{children}</a>
+    ),
+  };
+});
+
+vi.mock("../components/MarkdownBody", () => ({
+  MarkdownBody: ({ children }: { children: string }) => <div>{children}</div>,
+}));
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+describe("AgentOverview", () => {
+  it("leads with audit cards, then Profile, Skills and Recent tasks", async () => {
+    const agent = {
+      id: "agent-1",
+      companyId: "company-1",
+      name: "Codex Coder",
+      urlKey: "codexcoder",
+      role: "engineer",
+      title: "Product engineer",
+      status: "active",
+      reportsTo: null,
+      capabilities: "Builds and verifies product changes.",
+      adapterType: "codex_local",
+      adapterConfig: { model: "gpt-5.6-sol" },
+      runtimeConfig: {},
+      chainOfCommand: [],
+      access: { canAssignTasks: true, taskAssignSource: "explicit_grant", membership: null, grants: [] },
+    } as unknown as AgentDetail;
+    const issue = {
+      id: "issue-1",
+      companyId: "company-1",
+      identifier: "PAP-42",
+      title: "Simplify agent information architecture",
+      status: "in_progress",
+      priority: "high",
+      updatedAt: new Date("2026-08-31T12:00:00Z"),
+    } as unknown as Issue;
+    const runtime = {
+      sessionDisplayId: "codex-session-42",
+    } as unknown as AgentRuntimeState;
+
+    const render = () => renderToStaticMarkup(
+      <QueryClientProvider client={new QueryClient()}><DialogProvider>
+        <TooltipProvider>
+        <AgentOverview
+          agent={agent}
+          runs={[] as HeartbeatRun[]}
+          assignedIssues={[issue]}
+          runtimeState={runtime}
+          directReportCount={2}
+          skillNames={["Design Guide", "Check PR"]}
+          agentRouteId="codexcoder"
+        />
+        </TooltipProvider>
+      </DialogProvider></QueryClientProvider>,
+    );
+
+    const markup = render();
+    for (const label of ["Activity", "Runs", "Costs", "Budget used", "Profile", "Skills", "Recent tasks"]) {
+      expect(markup).toContain(label);
+    }
+    for (const page of ["activity", "runs", "costs", "budgets"]) {
+      expect(markup).toContain(`href="/agents/codexcoder/${page}"`);
+    }
+    expect(markup).toContain("2 enabled");
+    expect(markup).toContain("Explore skills");
+    expect(markup).toContain('href="/agents/codexcoder/skills"');
+    expect(markup).toContain("Design Guide");
+    expect(markup).toContain("Simplify agent information architecture");
+    expect(markup).toContain("PAP-42");
+    expect(markup).toContain("See all tasks");
+    expect(markup).not.toContain("Latest Run");
+    expect(markup).not.toContain("Harness / Runtime");
+    expect(markup).not.toContain("Capabilities");
+    expect(markup).not.toContain("agentId=agent-1");
+    expect(markup).not.toContain("Created by");
+    for (const locale of ["ru", "en"] as const) {
+      await i18n.changeLanguage(locale);
+      const host = document.createElement("div");
+      host.innerHTML = render();
+      const labels = locale === "ru"
+        ? ["Активность", "Запуски", "Затраты", "Использовано из бюджета"]
+        : ["Activity", "Runs", "Costs", "Budget used"];
+      for (const [index, page] of ["activity", "runs", "costs", "budgets"].entries()) {
+        const link = host.querySelector(`a[href="/agents/codexcoder/${page}"]`);
+        expect(link).not.toBeNull();
+        expect(link?.textContent).toContain(labels[index]);
+      }
+      expect(host.textContent).toContain("Simplify agent information architecture");
+      expect(host.textContent).toContain("Design Guide");
+      expect(host.textContent).toContain("Check PR");
+      expect(host.querySelector('a[href="/agents/codexcoder/skills"]')?.textContent).toContain(locale === "ru" ? "Посмотреть навыки" : "Explore skills");
+    }
+  });
+
+  function renderOverview(createdByUserId: string | null, client: QueryClient) {
+    const agent = {
+      id: "agent-2",
+      companyId: "company-1",
+      name: "Shared Agent",
+      urlKey: "sharedagent",
+      role: "engineer",
+      title: null,
+      status: "idle",
+      reportsTo: null,
+      capabilities: null,
+      adapterType: "codex_local",
+      adapterConfig: {},
+      runtimeConfig: {},
+      createdByUserId,
+      chainOfCommand: [],
+      access: { canAssignTasks: true, taskAssignSource: "explicit_grant", membership: null, grants: [] },
+    } as unknown as AgentDetail;
+    return renderToStaticMarkup(
+      <QueryClientProvider client={client}><DialogProvider>
+        <AgentOverview
+          agent={agent}
+          runs={[] as HeartbeatRun[]}
+          assignedIssues={[]}
+          directReportCount={0}
+          skillNames={[]}
+          agentRouteId="sharedagent"
+        />
+      </DialogProvider></QueryClientProvider>,
+    );
+  }
+
+  function renderWithDirectory(createdByUserId: string, principalIds: string[]) {
+    const client = new QueryClient();
+    client.setQueryData(queryKeys.access.companyUserDirectory("company-1"), {
+      users: principalIds.map((principalId) => ({
+        principalId,
+        status: "active",
+        user: { id: principalId, name: principalId === "user-alice" ? "Alice Admin" : "Bob Builder", email: null, image: null },
+      })),
+    });
+    return renderOverview(createdByUserId, client);
+  }
+
+  function failedDirectoryClient() {
+    const client = new QueryClient({ defaultOptions: { queries: { retryOnMount: false } } });
+    client.getQueryCache().build(client, { queryKey: queryKeys.access.companyUserDirectory("company-1") }).setState({
+      status: "error",
+      error: new Error("Directory unavailable"),
+      fetchStatus: "idle",
+    });
+    return client;
+  }
+
+});
