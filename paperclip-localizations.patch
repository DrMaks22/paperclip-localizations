+    mockSecretsApi.providerHealth.mockResolvedValue({
+      providers: [
+        {
+          provider: "local_encrypted",
+          status: "warn",
+          message: "Local encrypted provider has a warning.",
+          warnings: ["Backup reminder"],
+        },
+      ],
+    });
+  });
+
+  afterEach(() => {
+    unmountActiveRoots();
+    container.remove();
+    document.body.innerHTML = "";
+    vi.resetAllMocks();
+  });
+
+  it("switches the redesigned secrets page live without translating secret names", async () => {
+    mockSecretsApi.list.mockResolvedValue([makeCompanySecret()]);
+    await renderSecrets(container);
+    try {
+      for (const [locale, help, search] of [
+        ["en", "How secrets work", "Search secrets"],
+        ["ru", "Как работают секреты", "Поиск секретов"],
+        ["en", "How secrets work", "Search secrets"],
+      ]) {
+        await act(async () => { await i18n.changeLanguage(locale); });
+        await flushReact();
+        expect(container.textContent).toContain(help);
+        expect(container.querySelector('input[data-page-search-target="true"]')?.getAttribute("aria-label")).toBe(search);
+        expect(container.textContent).toContain("OPENAI_API_KEY");
+      }
+      expect(mockSecretsApi.update).not.toHaveBeenCalled();
+    } finally {
+      await act(async () => { await i18n.changeLanguage("en"); });
+    }
+  });
+
+});
