@@ -0,0 +1,49 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import type { Agent, ExecutionAgentQueue } from "@paperclipai/shared";
+import { afterEach, expect, it, vi } from "vitest";
+import { setLocale } from "@/i18n";
+import { AgentQueueWait } from "./AgentQueueWait";
+import { useAgentRosterFilters } from "./agents/AgentRosterFilters";
+
+vi.mock("@/api/ai-connections", () => ({ aiConnectionsApi: { list: async () => ({ connections: [] }) } }));
+const agents = [{ id: "agent", name: "My agent", status: "idle", adapterType: "codex_local", adapterConfig: {}, runtimeConfig: {} }] as Agent[];
+const container = document.createElement("div");
+let root: ReturnType<typeof createRoot>;
+afterEach(async () => { await act(async () => { root?.unmount(); setLocale("en"); }); container.remove(); });
+
+it("refreshes memoized roster labels without changing the selected connection identity", async () => {
+  function RosterProbe() {
+    const filters = useAgentRosterFilters("company", agents);
+    return <><button onClick={() => filters.onChange({ ...filters.filters, connection: "local" })}>select</button>
+      <output>{filters.options.connection.map(option => option.label).join(",")}</output>
+      <span data-selection>{filters.filters.connection}</span><span data-match>{String(filters.matches(agents[0]))}</span></>;
+  }
+  document.body.append(container); root = createRoot(container);
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  await act(async () => root.render(<QueryClientProvider client={client}><RosterProbe /></QueryClientProvider>));
+  await act(async () => container.querySelector("button")!.click());
+  expect(container.querySelector("output")?.textContent).toBe("Local credentials");
+  await act(async () => setLocale("ru"));
+  expect(container.querySelector("output")?.textContent).toBe("Локальные учётные данные");
+  expect(container.querySelector("[data-selection]")?.textContent).toBe("local");
+  expect(container.querySelector("[data-match]")?.textContent).toBe("true");
+  await act(async () => setLocale("en"));
+  expect(container.querySelector("output")?.textContent).toBe("Local credentials");
+  client.clear();
+});
+
+it.each([1, 2, 5, 21])("switches queue guidance with Russian plurals for %i slots, preserving server data", async count => {
+  const queue = { agentId: "agent", agentName: "Authored Agent", maxConcurrentRuns: count, position: 2, queuedCount: 9 } as ExecutionAgentQueue;
+  const snapshot = JSON.stringify(queue);
+  document.body.append(container); root = createRoot(container);
+  await act(async () => root.render(<AgentQueueWait queue={queue} showConfigure={false} />));
+  expect(container.textContent).toContain("Waiting for Authored Agent");
+  await act(async () => setLocale("ru"));
+  expect(container.textContent).toContain("Ожидание агента Authored Agent");
+  expect(container.textContent).toContain(count === 1 || count === 21 ? "параллельного запуска" : "параллельных запусков");
+  expect(container.textContent).toContain("Место в очереди: 2 из 9");
+  expect(JSON.stringify(queue)).toBe(snapshot);
+});
