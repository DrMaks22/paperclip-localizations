+import { ROUTINE_SUGGESTION_WEEKDAYS, routineSuggestionCadenceLabel, type RoutineSuggestionCadence } from "@paperclipai/shared";
+import { i18n, t } from "@/i18n";
+
+/** Present structured cadence without changing the server label or the saved schedule. */
+export function routineCadenceDisplay(cadence: RoutineSuggestionCadence): string {
+  if (i18n.resolvedLanguage === "en") return routineSuggestionCadenceLabel(cadence);
+  const [hour, minute] = cadence.time.split(":").map(Number);
+  const time = new Intl.DateTimeFormat(i18n.resolvedLanguage, {
+    hour: "numeric", minute: "2-digit", timeZone: "UTC",
+  }).format(new Date(Date.UTC(2000, 0, 1, hour, minute)));
+  switch (cadence.frequency) {
+    case "daily": return t("localizationSchedule.dailyAt", { time });
+    case "weekdays": return t("localizationSchedule.weekdaysAt", { time });
+    case "weekly": {
+      const day = ROUTINE_SUGGESTION_WEEKDAYS.indexOf(cadence.dayOfWeek!);
+      return t("localizationSchedule.weeklyAt", { day: t(`localizationSchedule.day${day}`), time });
+    }
+    case "monthly": return t("localizationSchedule.monthlyAt", { day: cadence.dayOfMonth, time });
+  }
+}
