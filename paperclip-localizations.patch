+        { clientX: 200, clientY: 100 },
+      ]));
+      viewport.dispatchEvent(createTouchEvent("touchmove", [
+        { clientX: 75, clientY: 100 },
+        { clientX: 225, clientY: 100 },
+      ]));
+      viewport.dispatchEvent(createTouchEvent("touchend", []));
+    });
+
+    const after = readTransform(layer);
