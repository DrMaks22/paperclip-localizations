+++ b/ui/src/lib/provider-window-label.ts
@@ -0,0 +1,24 @@
+import { t } from "@/i18n";
+
+const exactLabels: Record<string, string> = {
+  "Usage window": "usageWindow", Usage: "usage", Weekly: "weekly", Daily: "daily",
+  "Weekly (with extra usage)": "weeklyExtra", "Extra usage": "extraUsage", Extra: "extra",
+};
+
+/** Translate only runner-generated labels, retaining arbitrary provider scope names. */
+export function providerWindowLabel(label: string): string {
+  if (Object.hasOwn(exactLabels, label)) return t(`nov09Display.window.${exactLabels[label]}`);
+  const full = label.match(/^(?:(\d+)-(week|day|hour|minute) window|(Weekly|Daily|Usage window))(?: \(([^\n]+)\))?$/);
+  if (full?.[0] === label) {
+    const base = full[1]
+      ? t(`nov09Display.window.${full[2]}`, { count: Number(full[1]) })
+      : t(`nov09Display.window.${exactLabels[full[3]]}`);
+    return full[4] ? `${base} (${full[4]})` : base;
+  }
+  const short = label.match(/^(\d+)([dhm])(?: ([^\n]+))?$/);
+  if (short?.[0] === label) {
+    const base = t(`nov09Display.window.short${short[2]}`, { count: Number(short[1]) });
+    return short[3] ? `${base} ${short[3]}` : base;
+  }
+  return label;
+}
