+import { responsibilityWorkSignalDisplay } from "./responsibility-work-signal-display";
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+function signal(kind: ResponsibilityWorkSignal["kind"], text: string, refType: ResponsibilityWorkSignal["refType"], count = 1): ResponsibilityWorkSignal {
+  return { kind, text, refType, refId: refType ? "preserved-id" : null, count, tone: "neutral" };
+}
+
+describe("responsibility work signal display boundary", () => {
+  it("projects every built-in shape and preserves its raw object through en → ru → en", async () => {
+    const inputs = [
+      signal("metric_stale", "Profit / Прогресс was last updated 21 days ago", "responsibility"),
+      signal("project_late", "My project is 2 days past its target date", "project"),
+      signal("project_due_soon", "My project is due today", "project"),
+      signal("project_due_soon", "My project is due tomorrow", "project"),
+      signal("project_due_soon", "My project is due in 5 days", "project"),
+      signal("task_blocked", "User-provided task is blocked", "issue"),
+      signal("tasks_open_agent", "2 open tasks with Agent / Пользователь", "agent", 2),
+      signal("tasks_open_person", "1 open task with Board member", "user"),
+      signal("tasks_open_unassigned", "5 open tasks not assigned to anyone", null, 5),
+      signal("tasks_completed_recently", "21 tasks completed in the last 7 days", null, 21),
+      signal("routine_paused", "Payroll is paused", "routine"),
+      signal("routine_failed", "Payroll failed on its last run (2026-11-23)", "routine"),
+      signal("routine_failed", "Payroll failed on its last run", "routine"),
+      signal("routine_active", "Payroll is active, last run merged into another run on 2026-11-23, next run 2026-11-24", "routine"),
+      signal("routine_active", "Payroll is active, next run 2026-11-24", "routine"),
+      signal("routine_active", "Payroll is active", "routine"),
+    ];
+    const snapshot = JSON.stringify(inputs);
+    await i18n.changeLanguage("en");
+    expect(inputs.map(responsibilityWorkSignalDisplay)).toEqual(inputs.map(item => item.text));
+    await i18n.changeLanguage("ru");
+    for (const item of inputs) {
+      expect(responsibilityWorkSignalDisplay(item)).not.toBe(item.text);
+      expect(responsibilityWorkSignalDisplay(item)).not.toMatch(/nov23WorkSignal/);
+    }
+    expect(responsibilityWorkSignalDisplay(inputs[0])).toContain("Profit / Прогресс");
+    expect(responsibilityWorkSignalDisplay(inputs[6])).toBe("Agent / Пользователь: 2 открытые задачи");
+    expect(responsibilityWorkSignalDisplay(inputs[13])).toContain("23 нояб. 2026");
+    expect(JSON.stringify(inputs)).toBe(snapshot);
+    await i18n.changeLanguage("en");
+    expect(inputs.map(responsibilityWorkSignalDisplay)).toEqual(inputs.map(item => item.text));
+  });
