+  };
+}
+
+function makeSkill(over: Partial<CompanySkillDetail> = {}): CompanySkillDetail {
+  return {
+    id: "skill-1",
+    companyId: "company-1",
+    key: "github/anthropics/skills",
+    slug: "deep-research",
+    name: "Deep Research",
+    description: null,
