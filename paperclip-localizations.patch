+  "No recovery request is confirmed yet. Trying again will reuse the saved request.": "nov09Core.notice0475773ab5",
+};
+
+export function nov09NoticeDisplay(message: string): string {
+  if (Object.hasOwn(NOTICE_KEYS, message)) return t(NOTICE_KEYS[message]);
+  const source = /^Paperclip can’t verify the saved files’ recorded source \(([^()]+)\)\.$/.exec(message);
+  if (source) return t("nov09Core.unverifiedSource", { code: source[1] });
+  const prefix = "Recovery request was not confirmed: ";
+  if (message.startsWith(prefix)) return t("nov09Core.recoveryUnconfirmed", { error: nov09NoticeDisplay(message.slice(prefix.length)) });
+  return message;
+}
