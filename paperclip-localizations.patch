+    return t(`localizationTaskRuntime.durationShort_${key}`, { value: new Intl.NumberFormat(i18n.resolvedLanguage, { minimumFractionDigits: raw.includes(".") ? raw.split(".")[1]!.length : 0 }).format(number) });
