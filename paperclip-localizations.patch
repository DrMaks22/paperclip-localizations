+  const shortVerbs = ["Reading", "Read", "Writing", "Wrote", "Editing", "Edited", "Applying", "Applied", "Searching", "Searched", "Fetching", "Fetched", "Loading", "Loaded", "Inspecting", "Inspected", "Listing", "Listed", "Opening", "Opened", "Updating", "Updated", "Creating", "Created", "Deleting", "Deleted", "Moving", "Moved", "Running", "Ran"];
