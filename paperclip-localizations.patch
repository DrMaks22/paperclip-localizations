diff --git a/ui/src/lib/attention-nov16-localization.test.ts b/ui/src/lib/attention-nov16-localization.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79aef6eaa3069a893244a12c7472cd5805e4ca75
--- /dev/null
+++ b/ui/src/lib/attention-nov16-localization.test.ts
@@ -0,0 +1,46 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { normalizeClaudeRunnerOptions, type AgentConfigurationWarning } from "@paperclipai/shared";
+import { i18n } from "@/i18n";
+import { ApiError } from "@/api/api-error";
+import { configurationWarningMessages } from "./configuration-warnings";
+import { describeInteractionResolutionFailureDisplay } from "./interaction-resolution-error";
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+describe("November task display projections", () => {
+  it("translates known configuration warnings and preserves unknown messages and environment names", async () => {
+    const warnings: AgentConfigurationWarning[] = [
+      ...normalizeClaudeRunnerOptions({ maxTurnsPerRun: 10, chrome: true }).warnings,
+      { code: "protected_environment_variable", field: "env.API_KEY", message: "API_KEY is set by Production East on its tasks. Agents running there may see the platform's value instead of this one." },
+      { code: "runner_option_ignored", field: "custom", message: "Provider-supplied message: Keep English" },
+    ];
+    const original = warnings.map(warning => warning.message).join("\n");
+    for (const language of ["en", "ru", "en"]) {
+      await i18n.changeLanguage(language);
+      const display = configurationWarningMessages({ configurationWarnings: warnings });
+      if (language === "en") expect(display).toBe(original);
+      else {
+        expect(display).toContain("Paperclip Runner не поддерживает параметр");
+        expect(display).toContain("maxTurnsPerRun");
+        expect(display).toContain("API_KEY");
+        expect(display).toContain("Production East");
+      }
+      expect(display).toContain("Provider-supplied message: Keep English");
+    }
+    expect(warnings.map(warning => warning.message).join("\n")).toBe(original);
+  });
+
+  it("keeps tool-review denials settled and updates captured display messages with the language", async () => {
+    const source = "The tool definition changed. A new review is required.";
+    const code = "approved_tool_target_changed";
+    const error = new ApiError(source, 409, { error: source, code });
+    const failure = describeInteractionResolutionFailureDisplay(error);
+    for (const language of ["en", "ru", "en"]) {
+      await i18n.changeLanguage(language);
+      expect(failure.kind).toBe("settled");
+      expect(failure.code).toBe(code);
+      expect(failure.message).toBe(language === "en" ? source : "Определение инструмента изменилось. Требуется повторная проверка.");
+      expect(error.message).toBe(source);
+    }
+  });
+});
