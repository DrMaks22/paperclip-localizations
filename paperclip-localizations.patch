diff --git a/ui/src/lib/responsibility-work-signal-display.ts b/ui/src/lib/responsibility-work-signal-display.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67feb6d2c45947f9b2c274dd94fd2e136cf57257
--- /dev/null
+++ b/ui/src/lib/responsibility-work-signal-display.ts
@@ -0,0 +1,99 @@
+import { RESPONSIBILITY_RECENTLY_COMPLETED_DAYS, type ResponsibilityWorkSignal } from "@paperclipai/shared";
+import { i18n, t } from "@/i18n";
+
+const MORE: Partial<Record<ResponsibilityWorkSignal["kind"], readonly [string, string]>> = {
+  project_late: ["project is past the target date", "projects are past the target date"],
+  routine_failed: ["routine failed on the last run", "routines failed on the last run"],
+  task_blocked: ["task is blocked", "tasks are blocked"],
+  project_due_soon: ["project is due soon", "projects are due soon"],
+  routine_paused: ["routine is paused", "routines are paused"],
+  tasks_open_agent: ["open task with other agents", "open tasks with other agents"],
+  tasks_open_person: ["open task with other people", "open tasks with other people"],
+  routine_active: ["routine is active", "routines are active"],
+};
+
+function matchWhole(pattern: RegExp, text: string): RegExpExecArray | null {
+  const match = pattern.exec(text);
+  return match?.[0] === text ? match : null;
+}
+
+function dateDisplay(value: string): string {
+  const date = new Date(`${value}T00:00:00Z`);
+  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== value) return value;
+  return new Intl.DateTimeFormat(i18n.resolvedLanguage, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(date);
+}
+
+function activeRoutineParts(text: string): RegExpExecArray | null {
+  return matchWhole(/^([\s\S]+) is active(?:, last run (completed|succeeded|failed|was skipped|merged into another run|created a task|started) on (\d{4}-\d{2}-\d{2}))?(?:, next run (\d{4}-\d{2}-\d{2}))?$/, text);
+}
+
+const RUN_OUTCOMES: Record<string, string> = {
+  completed: "completed", succeeded: "completed", failed: "failed", "was skipped": "skipped",
+  "merged into another run": "coalesced", "created a task": "created", started: "started",
+};
+
+function activeRoutineDetails(match: RegExpExecArray): string[] {
+  const details: string[] = [];
+  if (match[2] && match[3]) details.push(t(`nov23WorkSignal.last_${RUN_OUTCOMES[match[2]]}`, { date: dateDisplay(match[3]) }));
+  if (match[4]) details.push(t("nov23WorkSignal.next_run", { date: dateDisplay(match[4]) }));
+  return details;
+}
+
+/** Only localize the known suffix; callers use the original suffix to classify the last run. */
+export function routineSignalDetailDisplay(signal: ResponsibilityWorkSignal, title: string, source: string): string {
+  if (i18n.resolvedLanguage?.startsWith("en") || signal.kind !== "routine_active"
+    || signal.count !== 1 || signal.refType !== "routine" || !signal.refId) return source;
+  const match = activeRoutineParts(signal.text);
+  return match && match[1] === title ? activeRoutineDetails(match).join(", ") || source : source;
+}
+
+/** Exact built-in server grammar only. Never mutate the signal used for matching or delegation. */
+export function responsibilityWorkSignalDisplay(signal: ResponsibilityWorkSignal): string {
+  const { kind, text, count, refType, refId } = signal;
+  if (i18n.resolvedLanguage?.startsWith("en") || !Number.isSafeInteger(count) || count < 1) return text;
+  const copy = (key: string, values: Record<string, string | number> = {}) => t(`nov23WorkSignal.${key}`, { count, ...values });
+  const more = MORE[kind];
+  if (more && refType === null && refId === null && text === `${count} more ${more[count === 1 ? 0 : 1]}`) {
+    return copy(`more_${kind}`);
+  }
+  if (kind === "tasks_open_unassigned" && refType === null && refId === null
+    && text === `${count} open ${count === 1 ? "task" : "tasks"} not assigned to anyone`) return copy(kind);
+  if (kind === "tasks_completed_recently" && refType === null && refId === null
+    && text === `${count} ${count === 1 ? "task" : "tasks"} completed in the last ${RESPONSIBILITY_RECENTLY_COMPLETED_DAYS} days`) {
+    return copy(kind, { days: RESPONSIBILITY_RECENTLY_COMPLETED_DAYS });
+  }
+  if ((kind === "tasks_open_agent" && refType === "agent" || kind === "tasks_open_person" && refType === "user") && refId) {
+    const prefix = `${count} open ${count === 1 ? "task" : "tasks"} with `;
+    if (text.startsWith(prefix) && text.length > prefix.length) return copy("tasks_open", { name: text.slice(prefix.length) });
+  }
+  if (count !== 1 || !refId) return text;
+  if (kind === "metric_stale" && refType === "responsibility") {
+    const match = matchWhole(/^([\s\S]+) was last updated (0|[1-9]\d*) (day|days) ago$/, text);
+    if (match && match[3] === (Number(match[2]) === 1 ? "day" : "days")) return copy(kind, { name: match[1], count: Number(match[2]) });
+  }
+  if (kind === "project_late" && refType === "project") {
+    const match = matchWhole(/^([\s\S]+) is ([1-9]\d*) (day|days) past its target date$/, text);
+    if (match && match[3] === (Number(match[2]) === 1 ? "day" : "days")) return copy(kind, { name: match[1], count: Number(match[2]) });
+  }
+  if (kind === "project_due_soon" && refType === "project") {
+    const match = matchWhole(/^([\s\S]+) is due (today|tomorrow|in ([2-9]|[1-9]\d+) days)$/, text);
+    if (match) return match[3] ? copy("project_due_days", { name: match[1], count: Number(match[3]) }) : copy(`project_due_${match[2]}`, { name: match[1] });
+  }
+  if (kind === "task_blocked" && refType === "issue") {
+    const match = matchWhole(/^([\s\S]+) is blocked$/, text);
+    if (match) return copy(kind, { name: match[1] });
+  }
+  if (kind === "routine_paused" && refType === "routine") {
+    const match = matchWhole(/^([\s\S]+) is paused$/, text);
+    if (match) return copy(kind, { name: match[1] });
+  }
+  if (kind === "routine_failed" && refType === "routine") {
+    const match = matchWhole(/^([\s\S]+) failed on its last run(?: \((\d{4}-\d{2}-\d{2})\))?$/, text);
+    if (match) return copy(match[2] ? "routine_failed_date" : kind, { name: match[1], date: match[2] ? dateDisplay(match[2]) : "" });
+  }
+  if (kind === "routine_active" && refType === "routine") {
+    const match = activeRoutineParts(text);
+    if (match) return [copy(kind, { name: match[1] }), ...activeRoutineDetails(match)].join(", ");
+  }
+  return text;
+}
