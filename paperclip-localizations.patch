@@ -0,0 +1,101 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { automationHintForTask, routineSuggestionCadenceLabel } from "@paperclipai/shared";
+import { i18n } from "@/i18n";
+import { fundraisingDetail, RESPONSIBILITY_FIXTURE_NOW } from "../../storybook/fixtures/responsibilities";
+import { statusReportFixture, statusSummaryFixture } from "../../storybook/fixtures/responsibility-status-reports";
+import { agentStatusRow, agentStatusTiles } from "./responsibility-agent-status";
+import { automationCadenceLabel, automationHintWhy, automationTriggerLabel, describeCheckAge } from "./responsibility-automation";
+import { dashboardVersionSummaryDisplay } from "./responsibility-dashboard";
+import { projectDueStat, projectProgressLabel } from "./responsibility-one-screen-v2";
+import { outlineV2CountsLabel } from "./responsibility-outline-v2";
+import { explainResponsibilityStatus, overallStanding, workBearings } from "./responsibility-views";
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+describe("localized responsibility views", () => {
+  it.each([
+    [1, "1 направление и 1 зона ответственности", "1 минуту назад"],
+    [2, "2 направления и 2 зоны ответственности", "2 минуты назад"],
+    [5, "5 направлений и 5 зон ответственности", "5 минут назад"],
+    [21, "21 направление и 21 зона ответственности", "21 минуту назад"],
+  ] as const)("declines the two outline counts and the check age (%i)", async (count, outline, age) => {
+    await i18n.changeLanguage("ru");
+    expect(outlineV2CountsLabel({ areas: count, responsibilities: count })).toBe(outline);
+    expect(describeCheckAge(new Date(0), new Date(count * 60_000))).toBe(age);
+  });
+
+  it("updates dashboard sentences and progress after a language switch", async () => {
+    const counts = { behind: 2, at_risk: 5, on_track: 4, not_measured: 0 };
+    const now = new Date(2026, 10, 13);
+    const project = { targetDate: "2026-11-08" };
+    await i18n.changeLanguage("ru");
+    expect(overallStanding(counts).sentence).toBe("Отстают 2 зоны ответственности, под угрозой — 5.");
+    expect(projectProgressLabel({ total: 21, done: 5 })).toBe("Готово задач: 5 из 21");
+    expect(projectDueStat(project, now)).toBe("Просрочено на 5 дней");
+    await i18n.changeLanguage("en");
+    expect(overallStanding(counts).sentence).toBe("2 responsibilities are behind and 5 are at risk.");
+    expect(projectDueStat(project, now)).toBe("5 days late");
+  });
+
+  it("translates report metadata and leaves a person's written message verbatim", async () => {
+    const text = "Not measured: no metric is set";
+    const report = statusReportFixture({ status: "at_risk", message: text, detail: text, userId: "owner" });
+    const summary = statusSummaryFixture(fundraisingDetail.id, report);
+    const original = JSON.stringify(summary);
+    await i18n.changeLanguage("ru");
+    const row = agentStatusRow(fundraisingDetail, summary);
+    expect(row).toMatchObject({ label: "Под угрозой", message: text, detail: text, source: "person" });
+    expect(agentStatusTiles([row]).tiles.find((tile) => tile.kind === "at_risk")?.line).toBe("В 1 направлении");
+    expect(JSON.stringify(summary)).toBe(original);
+    await i18n.changeLanguage("en");
+    expect(agentStatusRow(fundraisingDetail, summary).label).toBe("At risk");
+  });
+
+  it("localizes the work explanation and run detail while classifying the raw signal", async () => {
+    const detail = structuredClone(fundraisingDetail);
+    const activeSignal = detail.rollup.workSummary.find((signal) => signal.kind === "routine_active")!;
+    const original = JSON.stringify(detail);
+    await i18n.changeLanguage("ru");
+    const explanation = explainResponsibilityStatus(detail);
+    expect(explanation.lines[0]?.text).toContain("Investor update deck");
+    expect(explanation.lines[0]?.text).not.toContain("past its target date");
+    const routine = workBearings(detail, RESPONSIBILITY_FIXTURE_NOW).find(({ item }) => item.id === activeSignal.refId);
+    expect(routine?.bearing).toBe("moving");
+    expect(routine?.reason).toContain("последний запуск завершён");
+    expect(routine?.reason).toContain("10 нояб. 2026");
+    expect(JSON.stringify(detail)).toBe(original);
+    await i18n.changeLanguage("en");
+    expect(workBearings(detail, RESPONSIBILITY_FIXTURE_NOW).find(({ item }) => item.id === activeSignal.refId)?.reason)
+      .toBe("Active, last run succeeded on 2026-11-10, next run 2026-11-17");
+  });
+
+  it("only translates generated hints, keeping quoted words and custom schedules or notes", async () => {
+    const hint = automationHintForTask({ title: "Send the WEEKLY update" })!;
+    const offer = hint.cadence!;
+    const label = routineSuggestionCadenceLabel(offer);
+    const original = JSON.stringify(hint);
+    await i18n.changeLanguage("ru");
+    expect(automationTriggerLabel("schedule")).toBe("По расписанию");
+    expect(automationHintWhy(hint)).toContain(`«${hint.words}»`);
+    expect(automationHintWhy(hint)).not.toContain("Every Monday");
+    expect(automationCadenceLabel(offer, label)).not.toBe(label);
+    expect(automationCadenceLabel(offer, "My special cadence")).toBe("My special cadence");
+    expect(automationHintWhy({ ...hint, why: "My own explanation" })).toBe("My own explanation");
+    expect(JSON.stringify(hint)).toBe(original);
+    await i18n.changeLanguage("en");
+    expect(automationHintWhy(hint)).toBe(hint.why);
+    expect(automationCadenceLabel(offer, label)).toBe(label);
+  });
+
+  it("recognizes whole persisted version summaries, including their conjunctions", async () => {
+    const generated = "Added 2 areas and 1 responsibility, renamed 1 area and filed 3 items";
+    await i18n.changeLanguage("ru");
+    expect(dashboardVersionSummaryDisplay(generated)).toBe("Добавлены 2 направления и добавлена 1 зона ответственности, переименовано 1 направление и привязаны 3 элемента");
+    expect(dashboardVersionSummaryDisplay("0 areas, 21 responsibilities")).toBe("0 направлений, 21 зона ответственности");
+    for (const custom of ["My changes", "Added 1 areas", "Renamed 2 areas, filed 1 item", "Added 3 items", "Added 1 area\n"]) {
+      expect(dashboardVersionSummaryDisplay(custom)).toBe(custom);
+    }
+    await i18n.changeLanguage("en");
+    expect(dashboardVersionSummaryDisplay(generated)).toBe(generated);
+  });
+});
