+function createFileDragEvent(type: string, files: File[]) {
+  const event = new Event(type, {
+    bubbles: true,
+    cancelable: true,
+  }) as Event & {
+    dataTransfer: {
+      types: string[];
+      files: File[];
+      dropEffect?: string;
+    };
+  };
+  event.dataTransfer = {
+    types: ["Files"],
+    files,
+  };
+  return event;
+}
