@@ -0,0 +1,100 @@
+// @vitest-environment jsdom
+
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { i18n } from "@/i18n";
+import { AutoApprovedBadge, AutoReviewDetail } from "./TaskChatAutoReview";
+import { TaskChatRunHealthBanner, partitionRunHealthItems } from "./TaskChatRunHealthBanner";
+import { WaitCountdown } from "./TaskChatProtocolActivityRow";
+import { TaskChatTurnStatusIsland, taskChatTurnStatusModel } from "./TaskChatTurnStatusIsland";
+import { taskChatProviderTitle, taskThreadMarkerDetailDisplay } from "./task-chat-display";
+import type { TaskChatProviderActivityItem } from "./task-chat-model";
+
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+function activity(overrides: Partial<TaskChatProviderActivityItem> = {}): TaskChatProviderActivityItem {
+  return {
+    id: "activity", kind: "protocol", surface: "provider_activity", family: "plan",
+    eventType: "plan.updated", status: "running", title: "Plan",
+    details: [], steps: [], links: [], children: [], ...overrides,
+  };
+}
+
+describe("November task-chat display localization", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  beforeEach(async () => {
+    await i18n.changeLanguage("en");
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+  });
+  afterEach(async () => {
+    act(() => root.unmount());
+    container.remove();
+    vi.restoreAllMocks();
+    await i18n.changeLanguage("en");
+  });
+
+  it("switches review and countdown display live while preserving provider rationale and the model", async () => {
+    vi.spyOn(Date, "now").mockReturnValue(Date.parse("2026-11-09T12:00:00Z"));
+    const review = { decision: "allowed" as const, riskLevel: "low", rationale: "Provider RAW: keep this.", userConsent: "explicit" };
+    const wait = activity({ family: "wait", eventType: "wait.started", title: "Intentional wait", startedAt: "2026-11-09T12:00:00Z", details: [{ label: "Planned Duration Ms", value: "12000" }] });
+    const raw = JSON.stringify({ review, wait });
+    act(() => root.render(<><AutoApprovedBadge review={review} /><AutoReviewDetail review={review} /><WaitCountdown item={wait} /></>));
+    expect(container.textContent).toContain("12s left");
+    await act(async () => { await i18n.changeLanguage("ru"); });
+    expect(container.textContent).toContain("одобрено автоматически");
+    expect(container.textContent).toContain("Риск: низкий");
+    expect(container.textContent).toContain("Разрешение пользователя: явное");
+    expect(container.textContent).toContain("Provider RAW: keep this.");
+    expect(container.querySelector('[data-testid="task-chat-wait-countdown"]')?.textContent).toMatch(/12\s*с/);
+    expect(container.textContent).not.toContain("12s");
+    expect(JSON.stringify({ review, wait })).toBe(raw);
+    await act(async () => { await i18n.changeLanguage("en"); });
+    expect(container.textContent).toContain("12s left");
+  });
+
+  it("distinguishes a missing server name from a real server named An", async () => {
+    const notice = activity({ family: "provider_notice", eventType: "provider.notice.recorded", details: [{ label: "Category", value: "mcp_server_startup_failed" }] });
+    const missing = partitionRunHealthItems([notice]).failures[0]!;
+    const named = partitionRunHealthItems([{ ...notice, details: [...notice.details, { label: "server", value: "An" }] }]).failures[0]!;
+    expect(missing.serverNameIsFallback).toBe(true);
+    expect(named.serverNameIsFallback).toBeUndefined();
+    await i18n.changeLanguage("ru");
+    act(() => root.render(<TaskChatRunHealthBanner failures={[named]} />));
+    expect(container.textContent).toContain("An");
+    act(() => root.render(<TaskChatRunHealthBanner failures={[missing]} />));
+    expect(container.textContent).not.toContain("An");
+  });
+
+  it("uses native-event provenance for titles and context details without rewriting provider text", async () => {
+    await i18n.changeLanguage("ru");
+    const plan = activity();
+    expect(taskChatProviderTitle(plan)).toBe("План");
+    expect(taskChatProviderTitle({ ...plan, eventType: "provider.custom", title: "Plan" })).toBe("Plan");
+    expect(taskChatProviderTitle({ ...plan, title: "Provider RAW plan" })).toBe("Provider RAW plan");
+    expect(taskThreadMarkerDetailDisplay("250k → 10k tokens", "context_compacted")).toContain("Токены:");
+    expect(taskThreadMarkerDetailDisplay("250k → 10k tokens", "interrupted")).toBe("250k → 10k tokens");
+    expect(taskThreadMarkerDetailDisplay("Provider RAW context", "context_compacted")).toBe("Provider RAW context");
+    for (const detail of ["250k → 10k tokens\n", "from 250k tokens\n", "250k → 10k tokens · Provider detail"]) {
+      expect(taskThreadMarkerDetailDisplay(detail, "context_compacted")).toBe(detail);
+    }
+  });
+
+  it.each([1, 2, 5, 21])("localizes completion for %i plan steps while leaving step text intact", async (count) => {
+    const plan = activity({ steps: Array.from({ length: count }, (_, index) => ({ id: String(index), label: `Provider step ${index}`, status: "completed" as const })) });
+    const raw = JSON.stringify(plan);
