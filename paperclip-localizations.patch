@@ -0,0 +1,16 @@
+import { t } from "@/i18n";
+
+/** Only the controller's generated diagnostics enter this presentation map. */
+export function voiceControllerErrorLabel(message: string | undefined): string | undefined {
+  switch (message) {
+    case "The call could not be fully closed. Retry ending it before starting another call.": return t("oct19Voice.theCallCouldNotBeFully_ika2k9");
+    case "Speko needs credits before starting a call. Add credits in Speko, then try again.": return t("oct19Voice.spekoNeedsCreditsBeforeStartingA_6kln3g");
+    case "The previous call was closed. Start voice again to reconnect; your task is preserved.": return t("oct19Voice.thePreviousCallWasClosedStart_j5wtcx");
+    case "Voice could not connect. Check microphone permissions and your connection, then try again.": return t("oct19Voice.voiceCouldNotConnectCheckMicrophone_1gl6vfr");
+    case "Microphone state could not be changed. Try again or end the call.": return t("oct19Voice.microphoneStateCouldNotBeChanged_1kntrc5");
+    case "A task update could not be delivered to voice. Open the task to read it.": return t("oct19Voice.aTaskUpdateCouldNotBe_1bg1rce");
+    case "The answer could not be repeated. Open the task to read it.": return t("oct19Voice.theAnswerCouldNotBeRepeated_16qqzax");
+    case "Audio playback is blocked. Check this browser’s sound settings.": return t("oct19Voice.audioPlaybackIsBlockedCheckThis_aqgp72");
+    default: return message;
+  }
+}
diff --git a/ui/src/components/workspace-recovery-copy.ts b/ui/src/components/workspace-recovery-copy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d964981e802fde23320d79f4f74180ec65cb15de
--- /dev/null
+++ b/ui/src/components/workspace-recovery-copy.ts
@@ -0,0 +1,28 @@
+import { t } from "@/i18n";
+
+const LOCAL_ERRORS = {
+  taskChanged: { message: "The task changed. Refresh and try again.", key: "oct26Transcript.taskChanged" },
+  taskChangedWhileSaving: { message: "The task changed while saving. Refresh to check its current state.", key: "oct26Transcript.taskChangedWhileSaving" },
+} as const;
+
+/** Only locally constructed errors have display codes; server messages stay literal. */
+export class WorkspaceRecoveryUiError extends Error {
+  constructor(readonly code: keyof typeof LOCAL_ERRORS) {
+    super(LOCAL_ERRORS[code].message);
+  }
+}
+
+export type WorkspaceRecoveryDisplayError =
+  | { kind: "local"; code: keyof typeof LOCAL_ERRORS }
+  | { kind: "external"; message: string }
+  | { kind: "fallback" };
+
+export function workspaceRecoveryDisplayError(cause: unknown): WorkspaceRecoveryDisplayError {
+  return cause instanceof WorkspaceRecoveryUiError ? { kind: "local", code: cause.code }
+    : cause instanceof Error ? { kind: "external", message: cause.message } : { kind: "fallback" };
+}
+
+export function workspaceRecoveryErrorText(error: WorkspaceRecoveryDisplayError, fallbackKey: "oct26Transcript.retryFailed" | "oct19Voice.branchRepairFallback"): string {
+  return error.kind === "local" ? t(LOCAL_ERRORS[error.code].key)
+    : error.kind === "external" ? error.message : t(fallbackKey);
+}
