+  // Same-named tools in other MCP namespaces and raw diagnostics stay unchanged.
+  const feedbackTool = /^(?:(?:mcp__paperclip__)|(?:mcp\.paperclip\.))?(submit_complaint|submit_suggestion)$/.exec(technicalName ?? "");
+  if (feedbackTool && feedbackTool[0] === technicalName) {
+    const complaint = feedbackTool[1] === "submit_complaint";
+    const name = complaint ? "Submit complaint" : "Submit suggestion";
+    if (value === `Running ${name}`) return t(complaint ? "oct7Beta.runningComplaint" : "oct7Beta.runningSuggestion");
+    if (value === `Ran ${name}`) return t(complaint ? "oct7Beta.ranComplaint" : "oct7Beta.ranSuggestion");
+    if (value === `Ran ${name} · failed`) return t(complaint ? "oct7Beta.failedComplaint" : "oct7Beta.failedSuggestion");
+    if (value === `Running ${name} · stopped`) return t(complaint ? "oct7Beta.stoppedComplaint" : "oct7Beta.stoppedSuggestion");
+  }
+  const direct = taskChatDisplayLabel(value);
+  if (direct !== value) return direct;
+  const suffix = /^(.*) · (failed|stopped|interrupted)$/.exec(value);
+  if (suffix) return t(`localizationTaskRuntime.toolSuffix_${suffix[2]}`, { action: taskChatToolActivityLabel(suffix[1], technicalName) });
