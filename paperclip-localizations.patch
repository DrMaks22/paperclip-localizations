+import { afterEach, describe, expect, it } from "vitest";
+import { i18n } from "@/i18n";
+import { formatContextTokens, formatLocalizedContextTokens } from "./context-tokens";
+import { providerWindowLabel } from "./provider-window-label";
+import { runCancellationLabel } from "./run-cancellation-label";
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+describe("localized display boundaries", () => {
+  it("retains canonical token data while formatting Russian UI counts", async () => {
+    expect(formatLocalizedContextTokens(1240)).toBe("1.2k");
+    await i18n.changeLanguage("ru");
+    expect(formatContextTokens(1240)).toBe("1.2k");
+    expect(formatLocalizedContextTokens(1240)).toBe("1,2 тыс.");
+    expect(formatLocalizedContextTokens(1_000_000)).toBe("1 млн");
+    expect(formatLocalizedContextTokens(950)).toBe("950");
+    await i18n.changeLanguage("en");
+    expect(formatLocalizedContextTokens(1240)).toBe("1.2k");
+  });
+
+  it("localizes generated quota grammar but preserves model scopes and unknown labels", async () => {
+    await i18n.changeLanguage("ru");
+    expect(providerWindowLabel("5-hour window (GPT-5.4)")).toBe("За 5 часов (GPT-5.4)");
+    expect(providerWindowLabel("2-week window")).toBe("За 2 недели");
+    expect(providerWindowLabel("Weekly (Opus)")).toBe("За неделю (Opus)");
+    expect(providerWindowLabel("7d Opus")).toBe("7 дн. Opus");
+    expect(providerWindowLabel("Weekly (with extra usage)")).toBe("За неделю (с дополнительным использованием)");
+    expect(providerWindowLabel("Custom provider allowance")).toBe("Custom provider allowance");
+    expect(providerWindowLabel("constructor")).toBe("constructor");
+    expect(providerWindowLabel("5-hour window\n")).toBe("5-hour window\n");
+    expect(providerWindowLabel("7d\n")).toBe("7d\n");
+    await i18n.changeLanguage("en");
+    expect(providerWindowLabel("5-hour window (GPT-5.4)")).toBe("5-hour window (GPT-5.4)");
+  });
+
+  it("retranslates cancellation text while preserving failed/grok/pending precedence", async () => {
+    expect(runCancellationLabel({ grokWork: true, isFailed: true, isPending: true })).toBe("Stopping Paperclip work…");
+    await i18n.changeLanguage("ru");
+    expect(runCancellationLabel({ grokWork: false, isFailed: true, isPending: false })).toBe("Остановить");
+    expect(runCancellationLabel({ grokWork: false, isFailed: false, isPending: false })).toBe("Отмена");
+  });
+});
