+      expect(literalActionCandidates(`logActivity(db, { action: "${action}", });`)).toEqual([action]);
+    }
+    const invalidation = "responsibility.dashboard_changed";
+    expect(literalActionCandidates(`publishLiveEvent({ type: "activity.logged", payload: { action: "${invalidation}", entityType: "responsibility" } });`)).toEqual([]);
+    expect(literalActionCandidates(`logActivity(db, { action: "${invalidation}", });`)).toEqual([invalidation]);
+  });
+
