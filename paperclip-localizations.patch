+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { i18n } from "../i18n";
+import { formatProviderLimitMessage, formatProviderLimitTime, providerLimitMessageResetAt } from "./provider-limit-message";
+
+describe("localized provider limit timestamps", () => {
+  const now = Date.parse("2099-11-18T19:00:00Z");
+  beforeEach(async () => {
+    vi.stubEnv("TZ", "UTC");
+    await i18n.changeLanguage("en");
+  });
+  afterEach(async () => {
+    await i18n.changeLanguage("en");
+    vi.unstubAllEnvs();
+  });
+
+  it.each([
+    [1, "через 1 минуту"],
+    [2, "через 2 минуты"],
+    [5, "через 5 минут"],
+    [21, "через 21 минуту"],
+  ])("uses Russian relative-time forms for %i minutes and keeps the absolute deadline", async (minutes, expected) => {
+    const timestamp = new Date(now + Number(minutes) * 60_000).toISOString();
+    expect(formatProviderLimitTime(timestamp, now)).toMatch(/^in \d+ minutes? \(/);
+    await i18n.changeLanguage("ru");
+    const value = formatProviderLimitTime(timestamp, now);
+    expect(value.startsWith(`${expected} (`)).toBe(true);
+    expect(value).toContain("2099");
+    expect(value).toContain("UTC");
+    expect(value).toContain(`19:${String(minutes).padStart(2, "0")}`);
+  });
+
+  it("switches present and past wording without changing canonical reset detection", async () => {
+    const timestamp = new Date(now).toISOString();
+    const message = `The provider usage limit resets at ${timestamp}.`;
+    for (const [locale, present, past] of [["en", "now", "2 minutes ago"], ["ru", "сейчас", "2 минуты назад"], ["en", "now", "2 minutes ago"]]) {
+      await i18n.changeLanguage(locale);
+      expect(formatProviderLimitTime(timestamp, now)).toMatch(new RegExp(`^${present} \\(`));
+      expect(formatProviderLimitTime(timestamp, now + 120_000)).toContain(past);
+      expect(providerLimitMessageResetAt(message)).toBe(now);
+      expect(formatProviderLimitMessage(message, now)).toContain(`The provider usage limit resets ${present} (`);
+      expect(formatProviderLimitMessage("User text: resets at " + timestamp, now)).toBe("User text: resets at " + timestamp);
+      expect(formatProviderLimitTime("opaque-provider-value", now)).toBe("opaque-provider-value");
+    }
+  });
+});
