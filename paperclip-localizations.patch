+import {
+  RESPONSIBILITY_BAR_TEMPLATES,
+  RESPONSIBILITY_METRIC_DISPLAY_LABEL as metricLabels,
+  RESPONSIBILITY_STATUS_REPORT_LABEL as reportLabels,
+  type ResponsibilityMetricKind,
+} from "@paperclipai/shared";
+import { t } from "@/i18n";
+
+// These UI adapters leave the shared protocol objects unchanged. If upstream
+// changes an English source message, show that new source until it is reviewed.
+const templateSource = {
+  volume: { label: "Volume", summary: "A count or amount that should be at least, or at most, a target." },
+  percentage: { label: "Percentage", summary: "A share from 0 to 100 that should be at least, or at most, a target." },
+  yes_no: { label: "Yes or no", summary: "A state that is either true or not. Yes is on track; no is behind." },
+  range: { label: "Range", summary: "A value that should stay between a low and a high bound." },
+} as const;
+
+export function responsibilityTemplateCopy(kind: ResponsibilityMetricKind, field: "label" | "summary"): string {
+  const source = RESPONSIBILITY_BAR_TEMPLATES[kind][field];
+  return source === templateSource[kind][field]
+    ? t(`nov23Responsibilities.templates.${kind}.${field}`)
+    : source;
+}
+
+function guardedLabels<K extends string>(source: Record<K, string>, expected: Record<K, string>, prefix: string): Record<K, string> {
+  const display = {} as Record<K, string>;
+  for (const key of Object.keys(expected) as K[]) {
+    Object.defineProperty(display, key, {
+      enumerable: true,
+      get: () => source[key] === expected[key] ? t(`${prefix}.${key}`) : source[key],
+    });
+  }
+  return display;
+}
+
+export const RESPONSIBILITY_METRIC_DISPLAY_LABEL = guardedLabels(metricLabels, {
+  number: "Large number", percent: "Percentage", line: "Line over time", bar: "Bars per week",
+}, "nov23Responsibilities.metricDisplay");
+
+export const RESPONSIBILITY_STATUS_REPORT_LABEL = guardedLabels(reportLabels, {
+  behind: "Behind", at_risk: "At risk", on_track: "On track", unknown: "Can't tell yet",
+}, "nov23Responsibilities.reportStatus");
+
+/** Translate only the closed grammar produced by shared responsibilityStatusRule. */
+export function responsibilityStatusRuleDisplay(source: string | null): string | null {
+  if (source === null) return null;
+  if (source === "On track when the answer is yes; behind when it is no") return t("nov23Responsibilities.rule.yesNo");
+  const rules: readonly [RegExp, string, readonly string[]][] = [
+    [/^On track between (.+) and (.+); at risk up to (.+) outside it; behind further out$/, "range", ["low", "high", "band"]],
+    [/^On track at (.+) or less; behind above that$/, "atMostZero", ["target"]],
+    [/^On track at (.+) or less; at risk up to (.+)$/, "atMost", ["target", "threshold"]],
+    [/^On track at (.+) or more; behind below that$/, "atLeastZero", ["target"]],
+    [/^On track at (.+) or more; at risk from (.+)$/, "atLeast", ["target", "threshold"]],
+  ];
+  for (const [pattern, key, fields] of rules) {
+    const match = pattern.exec(source);
+    if (match) return t(`nov23Responsibilities.rule.${key}`, Object.fromEntries(fields.map((field, index) => [field, match[index + 1]])));
+  }
+  return source;
+}
+
