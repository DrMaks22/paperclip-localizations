+    onData(handler: (data: string) => void) {
+      this.dataHandlers.push(handler);
+      return {
+        dispose: () => {
+          const index = this.dataHandlers.indexOf(handler);
+          if (index >= 0) this.dataHandlers.splice(index, 1);
