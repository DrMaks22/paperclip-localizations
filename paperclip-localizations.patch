+const statusSentences: readonly [RegExp, string, readonly string[]][] = [
+  [/^Not measured: no metric is set$/, "noMetric", []],
+  [/^Not measured: (.+?) has no range$/, "missingRange", ["name"]],
+  [/^Not measured: (.+?) has no target$/, "missingTarget", ["name"]],
+  [/^Not measured yet: no yes-or-no reading of (.+?)$/, "pendingYes", ["name"]],
+  [/^Not measured yet: no reading of (.+?) against a range of (.+?) to (.+?)$/, "pendingRange", ["name", "low", "high"]],
+  [/^Not measured yet: no reading of (.+?) against a target of at most (.+?)$/, "pendingMax", ["name", "target"]],
+  [/^Not measured yet: no reading of (.+?) against a target of (.+?)$/, "pendingTarget", ["name", "target"]],
+  [/^(.+?): (.+?), inside the range of (.+?) to (.+?)$/, "inside", ["name", "reading", "low", "high"]],
+  [/^(.+?): (.+?), (.+?) below the range of (.+?) to (.+?)$/, "below", ["name", "reading", "distance", "low", "high"]],
+  [/^(.+?): (.+?), (.+?) above the range of (.+?) to (.+?)$/, "above", ["name", "reading", "distance", "low", "high"]],
+  [/^(.+?): (.+?) against a target of at most (.+?)$/, "atMost", ["name", "reading", "target"]],
+  [/^(.+?): (.+?) against a target of at least (.+?)$/, "atLeast", ["name", "reading", "target"]],
+  [/^(.+?) of (.+?), target met$/, "targetMet", ["current", "rest"]],
+  [/^(.+?) of (.+?), below target$/, "targetBelow", ["current", "rest"]],
+  [/^(.+?) of (.+?), (\d+)% of target$/, "targetPercent", ["current", "rest", "percent"]],
+  [/^(.+?): yes$/, "yes", ["name"]],
+  [/^(.+?): no, the bar is yes$/, "no", ["name"]],
+];
+
+export function responsibilityStatusSentenceDisplay(source: string): string {
+  for (const [pattern, key, fields] of statusSentences) {
+    const match = pattern.exec(source);
+    if (match?.[0] === source) {
+      return t(`nov23Responsibilities.statusSentence.${key}`, Object.fromEntries(fields.map((field, index) => [field, match[index + 1]])));
+    }
+  }
+  return source;
+}
