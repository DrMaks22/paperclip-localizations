+import { afterEach, describe, expect, it } from "vitest";
+import { RESPONSIBILITY_BAR_TEMPLATES, RESPONSIBILITY_STATUS_REPORT_LABEL as protocolLabels } from "@paperclipai/shared";
+import { i18n } from "@/i18n";
+import {
+  responsibilityStatusRuleDisplay,
+  responsibilityStatusSentenceDisplay,
+  responsibilityTemplateCopy,
+  RESPONSIBILITY_STATUS_REPORT_LABEL,
+} from "./responsibility-display-copy";
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+describe("responsibility display language", () => {
+  it("updates loaded labels on a language change while keeping the English protocol", async () => {
+    for (const [locale, expected, behind] of [["en", "Volume", "Behind"], ["ru", "Количество", "Отставание"], ["en", "Volume", "Behind"]]) {
+      await i18n.changeLanguage(locale);
+      expect(responsibilityTemplateCopy("volume", "label")).toBe(expected);
+      expect(RESPONSIBILITY_STATUS_REPORT_LABEL.behind).toBe(behind);
+      expect(protocolLabels.behind).toBe("Behind");
+      expect(RESPONSIBILITY_BAR_TEMPLATES.volume.label).toBe("Volume");
+    }
+  });
+
+  it("translates generated readings without modifying names, values or unrecognized messages", async () => {
+    await i18n.changeLanguage("ru");
+    expect(responsibilityStatusSentenceDisplay("Not measured: no metric is set")).toBe("Показатель не задан");
+    const name = "Support / Продажи";
+    const value = responsibilityStatusSentenceDisplay(`Not measured: ${name} has no target`);
+    expect(value).toContain(name);
+    expect(value).not.toContain("has no target");
+    const rule = responsibilityStatusRuleDisplay("On track at USD 250 or less; behind above that");
+    expect(rule).toContain("USD 250");
+    expect(rule).not.toContain("On track");
+    const unknown = "Custom: SLA / юг (70%)";
+    expect(responsibilityStatusSentenceDisplay(unknown)).toBe(unknown);
+    expect(responsibilityStatusRuleDisplay(unknown)).toBe(unknown);
+    expect(responsibilityStatusRuleDisplay(null)).toBeNull();
+  });
+});
