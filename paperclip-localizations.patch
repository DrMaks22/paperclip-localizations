+// Read-only guard for the server's own literal/conditional event codes. It does
+// not scan user data or translate arbitrary plugin action strings. Finite codes
+// formed with templates are checked against their shared contracts below.
+function literalActionCandidates(source: string): string[] {
+  // The policy evaluator's action is a permission, not an activity event.
+  // Remove only that bounded call; a logActivity with the same code stays checked.
+  const activitySource = source
+    .replace(/companySkillPolicyService\(db\)\.evaluate\(\{[\s\S]*?\n\s*\}\);/g, "")
+    // These private audit records and the dashboard invalidation do not enter the activity feed.
+    // Match their producers so logActivity with the same literal still requires a label.
+    .replace(/\.insert\(toolAccessAuditEvents\)\.values\(\{[^{};]*?\baction:\s*"(?:connection\.google_access_(?:removal|retry)|workload_identity\.token_issued)"/g, "")
+    .replace(/\bpublishLiveEvent\(\{[^{};]*?\bpayload:\s*\{\s*action:\s*"responsibility\.dashboard_changed"/g, "");
+  return [...activitySource.matchAll(/\baction:\s*([^,]*),/g)].flatMap((expression) =>
+    [...expression[1].matchAll(/"([a-z_]+\.[a-z_.]+)"/g)].map((match) => match[1]),
+  );
+}
