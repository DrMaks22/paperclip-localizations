new file mode 100644
index 0000000000000000000000000000000000000000..8e1e654a1cbb18cc94a538e3797e25f9d5b256b4
--- /dev/null
+++ b/ui/src/components/task-chat/TaskChatRunnerActivityGroup.toolRows.test.tsx
@@ -0,0 +1,53 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { i18n } from "@/i18n";
+import { TaskChatRunnerActivityGroup, foldReadRuns, formatToolDuration } from "./TaskChatRunnerActivityGroup";
+import type { TaskChatActivityPhaseItem, TaskChatToolItem } from "./task-chat-model";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const tool = (id: string, fields: Partial<TaskChatToolItem>): TaskChatToolItem => ({
+  id, kind: "tool", name: "Bash", rawName: "Bash", status: "completed", ...fields,
+});
+const read = (id: string, path: string) => tool(id, { name: "Read", rawName: "Read", operation: "read", target: path, exitCode: 0 });
+const phase = (items: TaskChatToolItem[]): TaskChatActivityPhaseItem => ({ id: "phase", kind: "activity_phase", items, active: false, summary: "" });
+
+describe("tool row grammar", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  beforeEach(() => {
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+  });
+  afterEach(async () => {
+    await act(async () => { root.unmount(); await i18n.changeLanguage("en"); });
+    container.remove();
+  });
+
+  it("localizes compact verbs and duration units while preserving raw tool records and mounted rows", async () => {
+    const item = phase([
+      { ...read("read", "src/Original.ts"), durationMs: 120 },
+      tool("command", { target: "node --test", durationMs: 1_840 }),
+    ]);
+    const original = JSON.stringify(item);
+    act(() => root.render(<TaskChatRunnerActivityGroup defaultExpanded item={item} />));
+    const readRow = container.querySelector('[data-activity-row="read"]');
+    for (const [locale, verb, milliseconds, seconds] of [
+      ["ru", "Прочитано", "120 мс", "1,8 с"],
+      ["en", "Read", "120ms", "1.8s"],
+    ]) {
+      await act(async () => { await i18n.changeLanguage(locale); });
+      expect(container.querySelector('[data-activity-row="read"]')).toBe(readRow);
+      expect(readRow?.textContent).toContain(verb);
+      expect(readRow?.textContent).toContain("src/Original.ts");
+      expect(readRow?.querySelector('[data-tool-duration]')?.textContent).toBe(milliseconds);
+      expect(container.querySelector('[data-activity-row="command"] [data-tool-duration]')?.textContent).toBe(seconds);
+      expect(JSON.stringify(item)).toBe(original);
+      expect(formatToolDuration(1_840)).toBe("1.8s");
+    }
+  });
+
+});
