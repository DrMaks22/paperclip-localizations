+import { afterEach, describe, expect, it } from "vitest";
+import { i18n, t } from "@/i18n";
+import { nov09NoticeDisplay } from "./nov09-presentation";
+
+afterEach(async () => { await i18n.changeLanguage("en"); });
+
+describe("November recovery presentation", () => {
+  it("projects exact system notices and preserves unknown/provider text across language changes", async () => {
+    const message = "Retry is waiting for the current run to finish. Your message is saved.";
+    const unknown = message + " Provider trace: X-42.";
+    for (const locale of ["en", "ru", "en"]) {
+      await i18n.changeLanguage(locale);
+      expect(nov09NoticeDisplay(message)).toBe(locale === "ru"
+        ? "Повторная попытка начнётся после завершения текущего запуска. Ваше сообщение сохранено."
+        : message);
+      expect(nov09NoticeDisplay(unknown)).toBe(unknown);
+      expect(message).toBe("Retry is waiting for the current run to finish. Your message is saved.");
+    }
+  });
+  it("preserves verification identifiers and unknown rejection details", async () => {
+    const source = "Paperclip can’t verify the saved files’ recorded source (allocation_X-42).";
+    await i18n.changeLanguage("ru");
+    expect(nov09NoticeDisplay(source)).toBe("Paperclip не может проверить записанный источник сохранённых файлов (allocation_X-42).");
+    expect(nov09NoticeDisplay("Recovery request was not confirmed: Provider details X-42"))
+      .toBe("Запрос на восстановление не подтверждён: Provider details X-42");
+    expect(nov09NoticeDisplay(source + " Custom note.")).toBe(source + " Custom note.");
+  });
+  it("uses Russian CLDR plurals for unread messages without changing agent names", async () => {
+    await i18n.changeLanguage("ru");
+    for (const [count, noun] of [[1, "сообщение"], [2, "сообщения"], [5, "сообщений"], [21, "сообщение"], [1.5, "сообщения"]] as const) {
+      expect(t("nov09Core.unreadFrom", { count, name: "Bot_X-42" })).toContain(noun);
+      expect(t("nov09Core.unreadFrom", { count, name: "Bot_X-42" })).toContain("Bot_X-42");
+    }
+    await i18n.changeLanguage("en");
+    expect(t("nov09Core.unreadFrom", { count: 2, name: "Bot_X-42" })).toBe("2 unread messages from Bot_X-42");
+  });
+});
