+function LocalizedRichText({
+  text,
+  replacements,
+}: {
+  text: string;
+  replacements: Record<string, ReactNode>;
+}) {
+  const markers = Object.keys(replacements);
+  if (markers.length === 0) return text;
+  const markerPattern = new RegExp(
+    `(${markers.map((marker) => marker.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`,
+    "g",
+  );
+  return text.split(markerPattern).map((part, index) => (
+    <Fragment key={`${part}-${index}`}>
+      {Object.prototype.hasOwnProperty.call(replacements, part) ? replacements[part] : part}
+    </Fragment>
+  ));
+}
 
