+      issue: {
+        id: "issue-1", identifier: "PAP-1", title: "English user title", status: "todo", priority: "medium",
+        assigneeAgentId: null, assigneeUserId: null, projectId: null, updatedAt: "2026-09-07T08:00:00Z",
+      },
+    };
