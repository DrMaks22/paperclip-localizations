diff --git a/ui/src/pages/Operations.localization.test.tsx b/ui/src/pages/Operations.localization.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..338eb8795638de68f6309e6e7fbc502b4aee323e
