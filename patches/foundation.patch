+    void i18n.changeLanguage("ru");
+    const warnings: PipelineHealthWarning[] = Array.from({ length: count }, (_, index) => ({
+      code: "paused_agent", stageId: `stage-${index}`, stageKey: "review", stageName: "Raw stage",
+      message: "Raw custom diagnostic",
+    }));
