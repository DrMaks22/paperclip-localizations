+    const issue = {
+      id: "issue-1", identifier: "PAP-1", title: "User task title", status: "todo",
+      updatedAt: "2026-09-07T08:00:00Z", blockedBy: [],
+    } as unknown as Issue;
+    const lineage = readRecoveryRetryLineage({
